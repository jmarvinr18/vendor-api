# Used by docker-compose.yml. Copy to .env and fill in.
POSTGRES_USER=vendor_portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vendor_portal

# Host ports (container ports are 5432 and 8000).
POSTGRES_HOST_PORT=5434
API_HOST_PORT=8000

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Local development only: vendor used when a request has no X-Vendor-Id header.
# Printed by `docker compose exec api flask seed-demo`.
DEFAULT_VENDOR_ID=

# ---- Document storage (invoice and supporting documents) ----
# "s3" (default) or "local" (container disk, development only).
STORAGE_BACKEND=s3
S3_BUCKET=vendor-portal-documents
S3_REGION=ap-southeast-1
# Object keys become <prefix>/invoices/<invoice id>/<random>.<ext>
S3_KEY_PREFIX=vendor-portal
# AES256 (S3-managed keys), aws:kms (set S3_KMS_KEY_ID too), or empty for the bucket default.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

# Where the OCR pipeline writes its result for a scan (same bucket). The API reads it while
# GET /api/v1/extractions/{id} is polled. {stem} = scan file name without extension.
EXTRACTION_RESULT_KEY_TEMPLATE=processed/{stem}.jsonl

# ---- AI assistant ----
# The agent itself is a separate repository (LangChain / LangGraph) hosted on Amazon Bedrock
# AgentCore. POST /api/v1/ai/messages relays the vendor's message to it.
# Set the runtime ARN to call AgentCore; the AWS identity below needs
# bedrock-agentcore:InvokeAgentRuntime on it.
AI_AGENT_RUNTIME_ARN=
AI_AGENT_REGION=ap-southeast-1
AI_AGENT_QUALIFIER=DEFAULT
# Used instead when no runtime ARN is set: the agent over plain HTTP (e.g. running it locally).
# The API calls this from inside its container, so "localhost" is the container itself:
# for an agent on your host use http://host.docker.internal:<port>/invocations.
AI_AGENT_URL=
# Sent as "Authorization: Bearer ..." with AI_AGENT_URL.
AI_AGENT_TOKEN=
AI_AGENT_TIMEOUT_SECONDS=75
AI_RATE_LIMIT_PER_MINUTE=10

# AWS credentials for an IAM user limited to this bucket (s3:PutObject, s3:GetObject,
# s3:DeleteObject on arn:aws:s3:::<bucket>/<prefix>/*). Leave empty on ECS/EC2 to use the role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Local S3 emulator instead of AWS: docker compose --profile local-s3 up -d ----
# S3_ENDPOINT_URL=http://s3:5000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

{
  "Comment": "Scanned invoice uploaded to S3 -> Textract text detection -> Lambda (Comprehend entities + store in the vendor portal database)",
  "StartAt": "StartTextDetection",
  "TimeoutSeconds": 900,
  "States": {
    "StartTextDetection": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:textract:startDocumentTextDetection",
      "Parameters": {
        "DocumentLocation": {
          "S3Object": {
            "Bucket.$": "$.detail.bucket.name",
            "Name.$": "$.detail.object.key"
          }
        }
      },
      "ResultSelector": {
        "JobId.$": "$.JobId"
      },
      "ResultPath": "$.textract",
      "Retry": [
        {
          "ErrorEquals": [
            "Textract.ThrottlingException",
            "Textract.ProvisionedThroughputExceededException",
            "Textract.LimitExceededException",
            "Textract.InternalServerErrorException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "WaitForTextract"
    },
    "WaitForTextract": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "GetJobStatus"
    },
    "GetJobStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:textract:getDocumentTextDetection",
      "Parameters": {
        "JobId.$": "$.textract.JobId",
        "MaxResults": 1
      },
      "ResultSelector": {
        "JobStatus.$": "$.JobStatus"
      },
      "ResultPath": "$.textract.status",
      "Retry": [
        {
          "ErrorEquals": [
            "Textract.ThrottlingException",
            "Textract.ProvisionedThroughputExceededException",
            "Textract.InternalServerErrorException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "IsJobDone"
    },
    "IsJobDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            { "Variable": "$.textract.status.JobStatus", "StringEquals": "SUCCEEDED" },
            { "Variable": "$.textract.status.JobStatus", "StringEquals": "PARTIAL_SUCCESS" }
          ],
          "Next": "StoreExtraction"
        },
        {
          "Variable": "$.textract.status.JobStatus",
          "StringEquals": "FAILED",
          "Next": "TextractJobFailed"
        }
      ],
      "Default": "WaitForTextract"
    },
    "TextractJobFailed": {
      "Type": "Pass",
      "Result": {
        "Error": "Textract.JobFailed",
        "Cause": "Textract could not process the document."
      },
      "ResultPath": "$.error",
      "Next": "MarkFailed"
    },
    "StoreExtraction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StoreExtractionFunctionArn}",
        "Payload": {
          "bucket.$": "$.detail.bucket.name",
          "key.$": "$.detail.object.key",
          "jobId.$": "$.textract.JobId"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StoreExtractionFunctionArn}",
        "Payload": {
          "bucket.$": "$.detail.bucket.name",
          "key.$": "$.detail.object.key",
          "error.$": "$.error"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Failed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "ExtractionFailed",
      "Cause": "Text extraction failed; the extraction was marked failed for the vendor."
    }
  }
}

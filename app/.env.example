DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_portal

# Where uploaded supporting documents are stored (defaults to ./uploads).
# UPLOAD_FOLDER=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Local development only: vendor used when a request has no X-Vendor-Id header.
# Printed by `flask seed-demo`.
# DEFAULT_VENDOR_ID=
